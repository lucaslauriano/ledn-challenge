# Copy to apps/backend/.env and set MONGODB_URI to your own MongoDB cluster.
# Do not commit real credentials. See README "Local Setup" for Atlas steps.

PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/ledn-challenge
NATS_URL=nats://localhost:4222
REDIS_HOST=localhost
REDIS_PORT=6379

# Feed simulation
FEED_INTERVAL_MS=1000
FEED_DELAYED_EVERY_NTH_TICK=5
FEED_DRIFT_MULTIPLIER=1.06
STALE_THRESHOLD_MS=5000

# Circuit breaker
CB_FAILURE_THRESHOLD=3
CB_SUCCESS_THRESHOLD=2
CB_TIMEOUT_MS=5000
